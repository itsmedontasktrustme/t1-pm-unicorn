# Copy to backend/.env.local (git-ignored); docker compose (compose.yaml) loads it into the backend.
#
# Google sign-in goes through Clerk (Clerk Dashboard -> SSO connections -> Google).
# The backend verifies the Clerk session token sent as "Authorization: Bearer <token>".
# Set at least one of the two keys, otherwise every protected /api endpoint answers 401.

# Clerk Dashboard -> API keys -> Secret key. Used to download the signing keys (JWKS).
CLERK_SECRET_KEY=

# Optional: Clerk Dashboard -> API keys -> JWT public key (PEM). Verifies tokens without
# any network call. Put it on one line with "\n" instead of the line breaks.
CLERK_JWT_KEY=

# Optional: comma separated origins of the frontend (checked against the token's "azp" claim).
CLERK_AUTHORIZED_PARTIES=http://localhost
